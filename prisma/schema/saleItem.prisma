model SaleItem {
  id                String   @id @default(cuid())
  saleId            String
  medicineId        String
  batchId           String // one row per batch (FEFO split)
  enteredUnit       UnitName
  enteredQty        Int
  quantityPieces    Int
  unitPricePerPiece Decimal  @db.Decimal(12, 2)
  costPricePerPiece Decimal  @db.Decimal(12, 2) // snapshot of batch purchase price at sale time
  lineSubtotal      Decimal  @db.Decimal(14, 2)
  returnedQtyPieces Int      @default(0)

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine    Medicine         @relation(fields: [medicineId], references: [id])
  batch       MedicineBatch    @relation(fields: [batchId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([medicineId])
  @@index([batchId])
}
