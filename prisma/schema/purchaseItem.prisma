model PurchaseItem {
  id                    String   @id @default(cuid())
  purchaseId            String
  medicineId            String
  batchId               String
  enteredUnit           UnitName
  enteredQty            Int
  quantityPieces        Int
  purchasePricePerPiece Decimal  @db.Decimal(12, 2)
  sellingPricePerPiece  Decimal  @db.Decimal(12, 2)
  mrpPerPiece           Decimal? @db.Decimal(12, 2)
  expiryDate            DateTime @db.Date
  lineTotal             Decimal  @db.Decimal(14, 2)
  returnedQtyPieces     Int      @default(0)

  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine    Medicine             @relation(fields: [medicineId], references: [id])
  batch       MedicineBatch        @relation(fields: [batchId], references: [id])
  returnItems PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([medicineId])
  @@index([batchId])
}
