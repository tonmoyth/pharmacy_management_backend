{
    "info": {
        "_postman_id": "a918f4d1-7e82-4b2a-9e12-88b14a6e35cb",
        "name": "Purchase Returns API",
        "description": "APIs for Purchase Returns Module (Pharmacy Owner & Staff)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000/api/v1",
            "type": "string"
        },
        {
            "key": "token",
            "value": "PASTE_YOUR_SESSION_OR_BEARER_TOKEN_HERE",
            "type": "string"
        },
        {
            "key": "purchaseId",
            "value": "cmuznec...purchase_id",
            "type": "string"
        },
        {
            "key": "purchaseItemId",
            "value": "cmuznec...item_id",
            "type": "string"
        },
        {
            "key": "returnId",
            "value": "",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "1. POST Create Purchase Return",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "if (pm.response.code === 201) {",
                            "    var res = pm.response.json();",
                            "    if (res.data && res.data.id) {",
                            "        pm.collectionVariables.set('returnId', res.data.id);",
                            "    }",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"purchaseId\": \"{{purchaseId}}\",\n  \"reason\": \"DAMAGED\",\n  \"note\": \"Damaged strips found in carton\",\n  \"items\": [\n    {\n      \"purchaseItemId\": \"{{purchaseItemId}}\",\n      \"quantity\": 2,\n      \"unit\": \"STRIP\"\n    }\n  ]\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/purchase-returns",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "purchase-returns"
                    ]
                },
                "description": "Create a purchase return. Reasons allowed: EXPIRED, DAMAGED, WRONG_ITEM, OTHER.\nUnits: BOX, STRIP, PIECE."
            },
            "response": []
        },
        {
            "name": "2. GET Purchase Returns (List with Pagination & Filters)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/purchase-returns?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "purchase-returns"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1"
                        },
                        {
                            "key": "limit",
                            "value": "10"
                        },
                        {
                            "key": "sortBy",
                            "value": "createdAt"
                        },
                        {
                            "key": "sortOrder",
                            "value": "desc"
                        },
                        {
                            "key": "supplierId",
                            "value": "",
                            "disabled": true
                        },
                        {
                            "key": "purchaseId",
                            "value": "",
                            "disabled": true
                        },
                        {
                            "key": "reason",
                            "value": "DAMAGED",
                            "disabled": true
                        },
                        {
                            "key": "dateFrom",
                            "value": "2026-10-01",
                            "disabled": true
                        },
                        {
                            "key": "dateTo",
                            "value": "2026-10-31",
                            "disabled": true
                        },
                        {
                            "key": "searchTerm",
                            "value": "PR-000001",
                            "disabled": true
                        }
                    ]
                },
                "description": "Get all purchase returns for current pharmacy with query filters."
            },
            "response": []
        },
        {
            "name": "3. GET Purchase Return Details by ID",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/purchase-returns/{{returnId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "purchase-returns",
                        "{{returnId}}"
                    ]
                },
                "description": "Fetch complete details of a specific purchase return by ID."
            },
            "response": []
        }
    ]
}